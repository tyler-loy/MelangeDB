<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>The reducer test kit: a real MelangeDB engine over a throwaway directory, driven by a hand-cranked clock. Call declared reducers through the production dispatch path, advance time to fire scheduled reducers deterministically, assert on typed write sets, and restart from the log in one call. No mocks, no test framework dependency.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MelangeDB.Core\MelangeDB.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

</Project>
