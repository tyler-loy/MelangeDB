<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>The paged IHotStore: a hybrid log with spill-to-disk. HotStore:PagedEngine picks the engine: MelangeDB's own log (the default) or Microsoft.FASTER.Core. See docs/design/hot-store-bakeoff.md.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MelangeDB.Core\MelangeDB.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MelangeDB.Storage.Faster.Tests" />
    <InternalsVisibleTo Include="MelangeDB.HotStoreBakeoff" />
    <!-- The native tree's suite measures internal types against Core's internal containers. -->
    <InternalsVisibleTo Include="MelangeDB.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.FASTER.Core" Version="2.6.5" />
    <!-- XxHash3, for melangelog's index and record checksums. -->
    <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
  </ItemGroup>

</Project>
