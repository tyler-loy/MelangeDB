<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>The paged IHotStore: a hybrid log with spill-to-disk, on Microsoft.FASTER.Core by default or MelangeDB's own log engine (HotStore:PagedEngine). See docs/design/hot-store-bakeoff.md.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MelangeDB.Core\MelangeDB.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MelangeDB.Storage.Faster.Tests" />
    <InternalsVisibleTo Include="MelangeDB.HotStoreBakeoff" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.FASTER.Core" Version="2.6.5" />
    <!-- XxHash3, for melangelog's index and record checksums. -->
    <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
  </ItemGroup>

</Project>
