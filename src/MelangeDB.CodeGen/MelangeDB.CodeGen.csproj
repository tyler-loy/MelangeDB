<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Roslyn source generators must target netstandard2.0. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Compile-time-only: the consuming PackageReference defaults to PrivateAssets="all", so
         the generator never flows transitively to the consumer's own consumers. -->
    <DevelopmentDependency>true</DevelopmentDependency>
    <!-- Roslyn is provided by the consuming compiler and the package has no lib/ output, so a
         dependencies element would be meaningless (and NU5128 agrees). -->
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <Description>Roslyn source generator: table/reducer registrations, serializers, and typed clients.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup Label="Analyzer packaging">
    <!-- Ships as an analyzer, never as a lib: consumers get compile-time codegen and no runtime dependency. -->
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
