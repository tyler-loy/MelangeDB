<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Schema model, write sets, transactions, the commit log, the reducer dispatcher, and the projection appliers.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MelangeDB.Abstractions\MelangeDB.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Solely for the commit log's append fault-injection seam and the engine's live-options
         instance; no test asserts on other internals. -->
    <InternalsVisibleTo Include="MelangeDB.Core.Tests" />
    <InternalsVisibleTo Include="MelangeDB.Host.Tests" />
    <InternalsVisibleTo Include="MelangeDB.Storage.Faster.Tests" />
    <!-- The transport's durability-gate test holds a group flush hostage through the commit
         log's flush fault-injection seam; it asserts on no other internals. -->
    <InternalsVisibleTo Include="MelangeDB.Transport.Tests" />
    <!-- The transport decodes stored row bytes on its own paths — projection, the HTTP column
         view, the projected-delta comparison — and shares the engine's decode-failure message so
         a row that no longer matches this build's schema names itself wherever it is first read. -->
    <InternalsVisibleTo Include="MelangeDB.Server" />
    <!-- The cluster package starts and stops per-shard schedulers and reads the engine's live
         options instance when composing per-shard engines. -->
    <InternalsVisibleTo Include="MelangeDB.Cluster" />
    <InternalsVisibleTo Include="MelangeDB.Cluster.Tests" />
    <!-- Both storage engines hold secondary indexes in the same container, and a range scan that
         seeks rather than walks is the same code in both. SecondaryIndex stays internal because it
         is an engine building block, not something a module should see. -->
    <InternalsVisibleTo Include="MelangeDB.Storage.Faster" />
    <!-- The commit-path benchmark measures LogRecordCodec on its own, because "which of the six
         allocation sites dominates" cannot be answered from the outside of a whole commit. -->
    <InternalsVisibleTo Include="MelangeDB.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <!-- Microsoft.Extensions.Diagnostics.HealthChecks is NOT an ASP.NET Core package: it is the
         Microsoft.Extensions health-check service usable from any generic host, and it is what
         lets AddMelangeDb register the melange-log check without the host doing anything. -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <!-- Telemetry needs no package reference: ActivitySource and Meter are in the
         net10.0 framework. MelangeDB emits signals; the host chooses exporters.
         Deliberately NO OpenTelemetry dependency here — see docs/OBSERVABILITY.md. -->
  </ItemGroup>

</Project>
