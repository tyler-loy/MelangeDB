<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Optional agent surface: a Model Context Protocol endpoint in the host's own pipeline. Agents read the schema, run ad-hoc SQL under the same rules as /melange/sql, read health and published signals, and call only the reducers named in code. Off until Mcp:Enabled; gated by its own role claim.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MelangeDB.Server\MelangeDB.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MelangeDB.Mcp.Tests" />
  </ItemGroup>

</Project>
