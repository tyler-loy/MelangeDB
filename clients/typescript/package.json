{
  "name": "@melangedb/client",
  "version": "0.4.2",
  "description": "The MelangeDB client for browsers (and Node): subscriptions into a merged, refcounted cache, reducer and producer calls, resume, and typed bindings generated by `melange generate --lang ts`.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyler-loy/MelangeDB.git",
    "directory": "clients/typescript"
  },
  "homepage": "https://github.com/tyler-loy/MelangeDB/blob/main/docs/CLIENT-BINDINGS.md",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && node --test \"build-test/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
