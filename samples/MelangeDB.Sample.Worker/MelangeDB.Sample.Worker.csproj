<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>MelangeDB.Sample</RootNamespace>
    <!-- Generator debuggability: generated sources land under obj/generated. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <Description>The first project that compiles against the real API: an ASP.NET Core host with tables and reducers discovered at compile time, serving the MelangeDB socket while the worker keeps greeting.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MelangeDB.Core\MelangeDB.Core.csproj" />
    <ProjectReference Include="..\..\src\MelangeDB.Server\MelangeDB.Server.csproj" />
    <ProjectReference Include="..\..\src\MelangeDB.CodeGen\MelangeDB.CodeGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
