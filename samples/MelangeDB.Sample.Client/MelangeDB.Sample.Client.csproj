<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>MelangeDB.Sample.Client</RootNamespace>
    <Description>A console client for the sample worker: connects, subscribes, calls a reducer, and watches the delta arrive.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MelangeDB.Client\MelangeDB.Client.csproj" />
    <ProjectReference Include="..\..\src\MelangeDB.CodeGen\MelangeDB.CodeGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The worker's exported schema; the analyzer generates the typed bindings from it. This is
         the whole client-side wiring: the library, the analyzer, and one JSON file. -->
    <AdditionalFiles Include="..\MelangeDB.Sample.Worker\melange-schema.json" />
  </ItemGroup>

</Project>
