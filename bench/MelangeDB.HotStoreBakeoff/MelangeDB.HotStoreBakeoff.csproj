<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The hot-store engine bake-off: candidate engines behind the paged store's IPagedKv seam, and a
    runner that drives each one through the same IHotStore workloads. A spike, not a package.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MelangeDB.Core\MelangeDB.Core.csproj" />
    <ProjectReference Include="..\..\src\MelangeDB.Storage.Faster\MelangeDB.Storage.Faster.csproj" />
    <ProjectReference Include="..\..\src\MelangeDB.CodeGen\MelangeDB.CodeGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LightningDB" Version="0.24.0" />
    <PackageReference Include="RocksDB" Version="11.12.0.7641" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
    <PackageReference Include="ZoneTree" Version="2.2.0" />
  </ItemGroup>

</Project>
