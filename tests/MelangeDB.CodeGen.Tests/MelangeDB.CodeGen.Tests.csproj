<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MelangeDB.CodeGen\MelangeDB.CodeGen.csproj" />
    <!-- Referenced only to hand their assemblies to test compilations as metadata references. -->
    <ProjectReference Include="..\..\src\MelangeDB.Abstractions\MelangeDB.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\MelangeDB.Core\MelangeDB.Core.csproj" />
    <ProjectReference Include="..\..\src\MelangeDB.Client\MelangeDB.Client.csproj" />
    <!-- `melange generate`, held byte-identical to this generator's own output. -->
    <ProjectReference Include="..\..\src\MelangeDB.Cli\MelangeDB.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Snapshots are expected generator output, compared as text — never compiled. -->
    <Compile Remove="Snapshots\**" />
    <None Include="Snapshots\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Real committed manifests, for the generate-versus-generator identity test. -->
    <None Include="..\..\conformance\melange-schema.json" Link="Manifests\conformance.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\MelangeDB.Transport.Tests\melange-schema.json" Link="Manifests\transport.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The committed TypeScript bindings, held to a fresh `melange generate`. -->
    <None Include="..\..\clients\typescript\conformance\melange-bindings.ts" Link="Bindings\conformance.ts" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\clients\typescript\test\generated\transport\melange-bindings.ts" Link="Bindings\transport.ts" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
